20 LET a = SYSTEM MemRead(2975248)
30 LET b = FOREIGN Run_SpecifyFunc(1674172, 1, 0, 2975248, 0, 0, 0, 0, 0)
40 SYSTEM ScreenInt32(20, 120, a)
50 SYSTEM ScreenInt32(20, 150, b)
60 IF a == 2027978464 THEN GOTO 90
70 SYSTEM ScreenString(20, 200, "MEMRWT NO")
80 GOTO 100
90 SYSTEM ScreenString(20, 200, "MEMRWT OK")
100 SYSTEM delay_us(3000000)
110 END
RUN
